generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Project system
// ─────────────────────────────────────────────────────────────────────────

enum ProjectType {
  SINGLE
  SERIES
}

model Project {
  id        String      @id @default(cuid())
  name      String
  type      ProjectType

  // Phase 4 — the one narrator voice for this whole project, same reasoning
  // as Character.voiceName (free text, provider-specific catalog). Kept at
  // Project rather than Scene so narration sounds like the same narrator in
  // every scene/episode instead of drifting take to take — the project owner
  // asked for character/narrator voices to stay consistent across an entire
  // story, not vary per scene.
  narratorVoiceName String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  story      Story?
  storyBible StoryBible?
  seasons    Season[]
  characters Character[]
  locations  Location[]

  // Visual-style anchor — a locked reference image (mood board / style
  // plate) fed into every shot image generation call for this project,
  // alongside any character/location references, so overall visual style
  // doesn't drift generation to generation. Same "first uploaded = the
  // reference" convention as Character/Location reference images (no
  // separate select step). Project-level rather than Story/StoryBible-level
  // since style should hold across Single Video and Series alike.
  styleReferences Asset[] @relation("ProjectStyleReference")

  // Phase 9 — format shape (act structure, typical scene/shot count,
  // runtime, tone) defined once per series so a new episode drafts against
  // it instead of a blank page. Series-only, same optionality as storyBible;
  // nullable in practice for series predating this feature (routes upsert
  // rather than assuming the row exists — see SeriesBlueprint below).
  blueprint SeriesBlueprint?

  // Phase 9 — uploaded PDF/DOCX source documents kept for traceability and
  // re-parsing, one-time ingestion into StoryBible + Characters + Locations
  // + SeriesBlueprint. Own relation, same "one concern per FK" convention as
  // styleReferences above.
  sourceDocuments Asset[] @relation("ProjectSourceDocument")

  // Thumbnail shown on the project card so projects are recognizable at a
  // glance in the dashboard grid. Purely cosmetic (not fed into generation,
  // unlike styleReferences) — own relation for that reason. Modeled as a
  // to-many relation for the same "Asset owns the FK back to its parent"
  // convention as every other relation on this model, but the API enforces
  // a single-image invariant (replacing the old cover on new upload) since
  // a card only ever shows one image.
  coverImage Asset[] @relation("ProjectCoverImage")

  // Nullable rather than required: pre-auth Project rows already exist in
  // production with no owner, and at `prisma migrate deploy` time (which
  // runs before the boot-time bootstrap script upserts the admin user) a
  // NOT NULL FK would have nothing valid to point at yet. The bootstrap
  // script backfills any ownerId IS NULL row to the admin's id right after
  // upserting the admin, before `pnpm start` accepts traffic — see
  // packages/db/src/bootstrap-admin.ts. proxy.ts treats ownerId === null as
  // admin-only-accessible as a safe default; this state should never be
  // visible to end users in practice, but code must not crash if it is.
  // onDelete SetNull (not Cascade) so deleting a user account doesn't
  // silently destroy their whole project tree — there's no undo for that.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────
// Story engine (Single Video)
// ─────────────────────────────────────────────────────────────────────────

model Story {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topic           String?
  premise         String?  @db.Text
  genre           String?
  tone            String?
  language        String?
  duration        String?
  narrationStyle  String?
  openingStyle    String?
  closingStyle    String?

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  scenes Scene[]

  // Phase 6 — rendered final-video attempts (ffmpeg assembly of every scene's
  // selected visual + audio, in order). Own relation/FK, same reasoning as
  // Scene.videoClips/Asset.videoSceneId: a separate concern from any other
  // Asset relation on this model.
  finalVideos Asset[] @relation("StoryFinalVideo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stories")
}

// ─────────────────────────────────────────────────────────────────────────
// Story Bible (Series)
// ─────────────────────────────────────────────────────────────────────────

model StoryBible {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  premise       String? @db.Text
  genre         String?
  tone          String?
  language      String?
  worldRules    String? @db.Text
  visualStyle   String? @db.Text
  timelineNotes String? @db.Text

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("story_bibles")
}

// ─────────────────────────────────────────────────────────────────────────
// Series Blueprint (Phase 9) — format shape for the series (act structure,
// typical scene/shot count, runtime, tone), defined once so new episodes
// draft against it instead of a blank page. Structurally mirrors StoryBible
// on purpose: setup fields + versioned content, same editor/route shape,
// reached by generation calls through assembleContext() rather than a new
// call site. Free-text fields throughout, same reasoning as StoryBible/
// Story (e.g. duration) — no premature structure like a scene-count int.
// ─────────────────────────────────────────────────────────────────────────

model SeriesBlueprint {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actStructure      String? @db.Text
  sceneShotGuidance String? @db.Text
  runtimeTarget     String?
  tone              String?

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("series_blueprints")
}

// ─────────────────────────────────────────────────────────────────────────
// Series structure: Seasons → Episodes
// ─────────────────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number    Int
  title     String?

  episodes  Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@map("seasons")
}

model Episode {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  number  Int
  title   String?
  summary String? @db.Text

  scenes Scene[]

  // Phase 6 — same reasoning as Story.finalVideos above.
  finalVideos Asset[] @relation("EpisodeFinalVideo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, number])
  @@map("episodes")
}

// ─────────────────────────────────────────────────────────────────────────
// Scene Engine (Phase 2) — breaks a Story (single video) or Episode (series)
// into ordered scenes. Plain-CRUD, not versioned: restoring a Version would
// mean deleting/recreating rows, which would orphan Assets that Phase 3
// later attaches via sceneId. Dual-optional FK mirrors Asset's
// characterId/locationId pattern — enforced at the API layer, not the DB.
// ─────────────────────────────────────────────────────────────────────────

enum SceneVisualMode {
  ILLUSTRATION
  IMAGE_TO_VIDEO
  TEXT_TO_VIDEO
}

model Scene {
  id String @id @default(cuid())

  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  order       Int
  title       String?
  description String @db.Text

  visualMode       SceneVisualMode @default(ILLUSTRATION)
  visualModeReason String?         @db.Text

  // Phase 4 — the narrator's spoken script for this scene, manually written
  // (mirrors Episode.summary: no AI-drafting step, only text-to-speech).
  narration String? @db.Text

  // Delivery direction for `narration` — mirrors DialogueLine.deliveryNotes/
  // speed exactly (same TTS instructions/speed passthrough in voice.ts, same
  // AI-proposes-then-user-can-overwrite idiom via NARRATION_DIRECTION, one
  // level up from DIALOGUE_DIRECTION's per-line version). Unlike `narration`
  // itself, these two *do* have an AI-drafting step — narration text stays
  // manual-only.
  narrationDeliveryNotes String? @db.Text
  narrationSpeed         Float?

  // Phase 5 — user-written camera/motion direction for IMAGE_TO_VIDEO scenes,
  // same manual-only pattern as narration (no AI-drafting step). Falls back
  // to `description` at generation time when unset.
  motionPrompt String? @db.Text
  // Desired clip length in seconds, user-set. Provider-specific bounds are
  // enforced at generation time, not in the schema.
  videoDurationSeconds Int?

  // Phase 5 — user-written prompt for TEXT_TO_VIDEO scenes, generated with no
  // source image at all. Kept separate from motionPrompt (which describes
  // motion layered on top of an existing image for IMAGE_TO_VIDEO) since a
  // text-to-video prompt has to carry the whole shot on its own. Falls back
  // to `description` at generation time when unset, same as motionPrompt.
  videoPrompt String? @db.Text

  // Phase 7 — the "Audio Plan" step: AI-drafted (via AUDIO_PLANNING), then
  // user-editable before the actual MUSIC_GENERATION/SFX_GENERATION call, same
  // pattern as visualModeReason (AI proposes, user can overwrite). Kept as two
  // separate fields, not one combined prompt, since music and sfx are
  // generated independently (different job types, different Asset relations
  // below) and a scene may want only one of the two. An empty prompt means
  // "don't generate this" — generation is blocked on blank, same idiom as
  // Scene.narration in voice.ts.
  musicPrompt String? @db.Text
  sfxPrompt   String? @db.Text
  // Mix levels applied at Phase 6 assembly time (0-1, relative to the voice
  // track which always plays at full volume). Defaults keep music
  // unobtrusive under dialogue/narration and sfx clearly audible.
  musicVolume Float @default(0.25)
  sfxVolume   Float @default(0.8)

  characters    Character[]
  locations     Location[]

  // Phase 8 — the scene's ordered shots, each carrying its own images (and,
  // for ILLUSTRATION scenes, its own camera movement). Scene stopped being
  // the image unit — see Shot below.
  shots Shot[]

  // Phase 4 — narration audio takes, kept on its own FK/relation rather than
  // reusing images' sceneId (see comment above).
  narrationAudio Asset[] @relation("SceneNarrationAudio")

  dialogueLines DialogueLine[]

  // Phase 5 — generated video clips (IMAGE_TO_VIDEO scenes only), same
  // separate-relation reasoning as narrationAudio: mixing clips into `images`
  // would break the image gallery's <img>-only assumption.
  videoClips Asset[] @relation("SceneVideoClips")

  // Phase 7 — background music bed and sound-effect takes, one selected slot
  // each (same take-history/isSelected pattern as narrationAudio), own
  // relations for the same reason narrationAudio/videoClips are separate from
  // `images`.
  music Asset[] @relation("SceneMusic")
  sfx   Asset[] @relation("SceneSfx")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, order])
  @@unique([episodeId, order])
  @@map("scenes")
}

// ─────────────────────────────────────────────────────────────────────────
// Shot Engine (Phase 8) — subdivides a Scene into an ordered sequence of
// distinct visual compositions. Each Shot is its own continuity frame — shot
// 2 continues the story from shot 1, it is not an alternate take of it.
// Alternates only exist *within* one Shot's own image gallery, the same
// isSelected take-history pattern Scene.images used to have. Scene stopped
// being the image unit and became a pure container (narrative description,
// tags, audio, music); Shots underneath now carry the visuals. Plain-CRUD,
// not versioned — same reasoning as Scene itself.
// ─────────────────────────────────────────────────────────────────────────

enum CameraMovement {
  STATIC
  ZOOM_IN
  ZOOM_OUT
  PAN_LEFT
  PAN_RIGHT
  PAN_UP
  PAN_DOWN
}

model Shot {
  id String @id @default(cuid())

  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  order       Int
  description String @db.Text

  // Only meaningful for ILLUSTRATION scenes — each shot's image is held via
  // Ken Burns for its own slice of the scene's audio duration, then
  // concatenated in order. For IMAGE_TO_VIDEO scenes, shots feed continuity
  // frames into ONE scene-level video generation instead (first shot's image
  // as first_frame, last shot's image as last_frame) rather than each
  // getting its own clip — see generateSceneVideo() in scene-video.ts. TEXT_
  // TO_VIDEO scenes don't use shots at all (no source image to speak of).
  cameraMovement CameraMovement @default(STATIC)

  // Optional explicit length; shots left unset evenly split whatever
  // duration remains of the scene's total audio after explicit ones are
  // subtracted out.
  durationSeconds Int?

  images Asset[] @relation("ShotImages")

  // Set right before an image-generation call starts, cleared in a finally
  // once it ends (success or failure) — lets the UI show a persisted
  // "Generating…" state across a page reload and lets the API reject a
  // second concurrent generate call as a duplicate. Treated as stale (i.e.
  // no generation is actually running) once older than the API route's
  // IMAGE_GENERATION_STALE_MS, so a crashed request can't leave this stuck
  // forever — see /api/shots/[id]/images/generate.
  imageGenerationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@map("shots")
}

// ─────────────────────────────────────────────────────────────────────────
// Character reference system
// ─────────────────────────────────────────────────────────────────────────

model Character {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  identity       String? @db.Text
  appearance     String? @db.Text
  personality    String? @db.Text
  clothing       String? @db.Text
  background     String? @db.Text
  characterArc   String? @db.Text
  isLocked       Boolean @default(false)

  // Phase 4 — free-text TTS voice name/id (e.g. "alloy"), not a fixed enum:
  // the set of valid voices is provider/model-specific and changes over
  // time, so this is user-entered rather than hardcoded, same reasoning as
  // AiModelOption not hardcoding model ids. Null falls back to whatever
  // voice the user picks at generation time.
  voiceName String?

  referenceImages Asset[]
  scenes          Scene[]
  dialogueLines   DialogueLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("characters")
}

// ─────────────────────────────────────────────────────────────────────────
// Location reference system
// ─────────────────────────────────────────────────────────────────────────

model Location {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  architecture String? @db.Text
  environment String? @db.Text
  timeWeather String?
  visualStyle String? @db.Text

  referenceImages Asset[]
  scenes          Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

// ─────────────────────────────────────────────────────────────────────────
// Voice pipeline (Phase 4) — dialogue lines are the per-Character spoken
// content within a Scene, distinct from Scene.narration (the narrator's
// script). Ordered like Scene itself; each line gets its own audio takes via
// Asset.dialogueLineId, so takes for one line never collide with another
// line's takes in the same scene the way a single shared column would.
// ─────────────────────────────────────────────────────────────────────────

model DialogueLine {
  id String @id @default(cuid())

  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  order Int
  text  String @db.Text

  // Phase 8 — "direction" for this line: AI-drafted (via DIALOGUE_DIRECTION,
  // one call per scene so a conversation's emotional beats stay coherent
  // across lines), then user-editable, same AI-drafts/user-edits pattern as
  // visualModeReason/musicPrompt. Both map to real, documented OpenAI-
  // compatible TTS params — deliveryNotes to `instructions`, speed to
  // `speed` — passed through in generateDialogueAudio() (lib/voice.ts).
  deliveryNotes String? @db.Text
  speed         Float?

  audio Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@map("dialogue_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Asset library. Phase 0+1 only stored reference images; Phase 3 adds
// GENERATED_IMAGE (originally scene images via sceneId, now shot images via
// shotId — see Shot model, Phase 8); Phase 4 adds AUDIO_NARRATION (via its
// own narrationSceneId FK, kept
// separate from sceneId so narration takes never show up in the image
// gallery) and AUDIO_DIALOGUE (via dialogueLineId). Phase 7 adds MUSIC (via
// musicSceneId) and SFX (via sfxSceneId) — both AI-generated (through
// OpenRouter's general /chat/completions audio-output modality, since it has
// no dedicated music/SFX endpoint the way images/speech/video do) or
// user-uploaded, same dual path as GENERATED_IMAGE.
// ─────────────────────────────────────────────────────────────────────────

enum AssetType {
  REFERENCE_IMAGE
  GENERATED_IMAGE
  VIDEO_CLIP
  AUDIO_NARRATION
  AUDIO_DIALOGUE
  SFX
  MUSIC
  // Phase 6 — a fully assembled Story/Episode render (ffmpeg-stitched scenes).
  FINAL_VIDEO
  // Phase 9 — an uploaded PDF/DOCX parsed into StoryBible + Characters +
  // Locations + SeriesBlueprint. Kept after parsing for traceability/re-runs.
  SOURCE_DOCUMENT
}

model Asset {
  id   String    @id @default(cuid())
  type AssetType

  storageKey String
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  metadata   Json?

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Phase 8 — a shot's own generated/uploaded image attempts, one selected
  // at a time (same isSelected take-history pattern as narrationAudio).
  shotId String?
  shot   Shot?   @relation("ShotImages", fields: [shotId], references: [id], onDelete: Cascade)

  narrationSceneId String?
  narrationScene   Scene? @relation("SceneNarrationAudio", fields: [narrationSceneId], references: [id], onDelete: Cascade)

  dialogueLineId String?
  dialogueLine   DialogueLine? @relation(fields: [dialogueLineId], references: [id], onDelete: Cascade)

  // Phase 5 — generated video clips, kept on their own FK/relation for the
  // same reason narrationAudio is (see Scene.videoClips comment).
  videoSceneId String?
  videoScene   Scene? @relation("SceneVideoClips", fields: [videoSceneId], references: [id], onDelete: Cascade)

  // Phase 7 — background music / sfx takes, own FK/relation pair each, same
  // reasoning as videoSceneId above.
  musicSceneId String?
  musicScene   Scene? @relation("SceneMusic", fields: [musicSceneId], references: [id], onDelete: Cascade)

  sfxSceneId String?
  sfxScene   Scene? @relation("SceneSfx", fields: [sfxSceneId], references: [id], onDelete: Cascade)

  // Phase 5 — which selected GENERATED_IMAGE this clip was generated from,
  // for traceability when a scene's image is later regenerated/reselected.
  // Self-relation, so it needs its own name and no onDelete cascade action
  // conflict with the other Asset relations above.
  sourceImageId String?
  sourceImage   Asset?  @relation("VideoSourceImage", fields: [sourceImageId], references: [id], onDelete: SetNull)
  clipsFromThisImage Asset[] @relation("VideoSourceImage")

  // Phase 6 — assembled final-video attempts, kept on their own FK/relation
  // for the same reason videoSceneId is (see Scene.videoClips comment).
  // Dual-optional, mirroring Scene's storyId/episodeId pattern: a FINAL_VIDEO
  // asset belongs to exactly one of Story or Episode, enforced at the API
  // layer, not the DB.
  storyVideoId String?
  storyVideo   Story? @relation("StoryFinalVideo", fields: [storyVideoId], references: [id], onDelete: Cascade)

  episodeVideoId String?
  episodeVideo   Episode? @relation("EpisodeFinalVideo", fields: [episodeVideoId], references: [id], onDelete: Cascade)

  // Project-level style anchor image — see Project.styleReferences.
  projectStyleId String?
  projectStyle   Project? @relation("ProjectStyleReference", fields: [projectStyleId], references: [id], onDelete: Cascade)

  // Phase 9 — uploaded source document (PDF/DOCX) — see Project.sourceDocuments.
  projectSourceId String?
  projectSource   Project? @relation("ProjectSourceDocument", fields: [projectSourceId], references: [id], onDelete: Cascade)

  // Project card thumbnail — see Project.coverImage.
  projectCoverId String?
  projectCover   Project? @relation("ProjectCoverImage", fields: [projectCoverId], references: [id], onDelete: Cascade)

  // Generation metadata — meaningful for AI-produced assets (GENERATED_IMAGE,
  // AUDIO_NARRATION, AUDIO_DIALOGUE). isSelected mirrors Version.isSelected:
  // newest generation always becomes selected, older attempts stay browsable,
  // scoped to whichever FK (sceneId+type, narrationSceneId, or
  // dialogueLineId) identifies the "slot" being regenerated. createdBy
  // defaults to USER so existing REFERENCE_IMAGE upload routes don't need
  // changes.
  isSelected Boolean   @default(false)
  prompt     String?   @db.Text
  modelId    String?
  createdBy  CreatedBy @default(USER)

  // Advisory-only consistency check against locked character/location
  // reference images. null = not validated (e.g. no reference image existed
  // to compare against) — never treated as a failure.
  validationPassed  Boolean?
  validationNotes   String?  @db.Text
  validationModelId String?

  createdAt DateTime @default(now())

  @@map("assets")
}

// ─────────────────────────────────────────────────────────────────────────
// Generic versioning — reused across Story, StoryBible, and (later) Scene,
// Character, Image, etc. entityType + entityId instead of a table per kind.
// ─────────────────────────────────────────────────────────────────────────

enum VersionEntityType {
  STORY
  STORY_BIBLE
  // Phase 9 — same versioned-content pattern as STORY_BIBLE, for SeriesBlueprint.content.
  SERIES_BLUEPRINT
}

enum CreatedBy {
  USER
  AI
}

model Version {
  id         String            @id @default(cuid())
  entityType VersionEntityType
  entityId   String

  versionNumber Int
  payload       Json
  isSelected    Boolean @default(false)

  prompt             String?  @db.Text
  modelId            String?
  generationSettings Json?
  createdBy          CreatedBy

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId])
  @@map("versions")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Model Registry — every dropdown in the app reads from this table.
// Nothing in application code should hardcode a model id.
// ─────────────────────────────────────────────────────────────────────────

enum AiJobType {
  MASTER_AI
  STORY_WRITING
  SCENE_PLANNING
  IMAGE_PROMPTS
  IMAGE_GENERATION
  IMAGE_VALIDATION
  VOICE
  // Phase 5 — image-to-video clip generation via a hosted AI video model.
  // Kept distinct from VIDEO below, which is reserved for local ffmpeg
  // assembly of the final output (a later, separate phase).
  VIDEO_GENERATION
  VIDEO
  // Phase 7 — the "Audio Plan" step: drafts Scene.musicPrompt/sfxPrompt from
  // the scene's description + style context, same shape as IMAGE_PROMPTS.
  AUDIO_PLANNING
  // Phase 7 — kept as two distinct job types (not one AUDIO_GENERATION) since
  // music and sound effects are generated independently and a provider well
  // suited to one (e.g. a music model like Lyria) isn't necessarily suited to
  // the other.
  MUSIC_GENERATION
  SFX_GENERATION
  // Phase 8 — proposes an ordered list of Shots for one scene (mirrors
  // SCENE_PLANNING one level down: Story→Scenes becomes Scene→Shots).
  SHOT_PLANNING
  // Phase 8 — drafts DialogueLine.deliveryNotes/speed for every line in a
  // scene in one call, so a conversation's delivery stays coherent.
  DIALOGUE_DIRECTION
  // Mirrors DIALOGUE_DIRECTION one level up: drafts Scene.narrationDeliveryNotes/
  // narrationSpeed from the scene's own narration text — see
  // generateNarrationDirection in lib/voice.ts.
  NARRATION_DIRECTION
  // Drafts Scene.narration plus, only when the scene currently has none, new
  // DialogueLine rows for characters already attached to the scene — same
  // "AI proposes, user can overwrite/edit" shape as AUDIO_PLANNING, one level
  // up from DIALOGUE_DIRECTION (which only redirects lines that already
  // exist). See generateSceneScript in lib/voice.ts.
  SCRIPT_DRAFTING
  // Story chat AI — a conversational surface scoped to a Story/Episode,
  // reusing the Context Engine as system context. No dedicated schema for
  // chat history (kept client-side, stateless per request, same "simpler"
  // reasoning as not persisting it); "Add to Story"/"Add to Episode Summary"
  // applies a reply through the existing content/summary save routes.
  STORY_CHAT
  // Phase 9 — one-time document ingestion: extracts StoryBible +
  // SeriesBlueprint + Characters + Locations from an uploaded PDF/DOCX's
  // text as a single strict-JSON call. Result is a preview, not a write —
  // see lib/story-ingestion.ts.
  STORY_INGESTION
  // Phase 9 — SeriesBlueprint's own "Generate" button, drafting from
  // assembleContext() (which by then includes StoryBible/Characters/
  // Locations). Mirrors STORY_WRITING one level down.
  BLUEPRINT_PLANNING
  // Drafts Scene.motionPrompt for IMAGE_TO_VIDEO scenes from two multimodal
  // inputs in one call: the current scene's selected shot image (what's in
  // frame) and the immediately preceding scene's selected video clip (what
  // just happened, visually and in audio) via OpenRouter's video-input
  // content part — falls back to the previous scene's description text when
  // it has no generated clip yet. Needs a video-input-capable model (e.g.
  // Gemini 2.5 Pro/Flash); see generateSceneVideo in lib/scene-video.ts.
  MOTION_PROMPT_DRAFTING
  // Phase 11 — one whole-story/episode pass that watches the fully
  // assembled, still-silent picture (video-input content part, same
  // mechanism as MOTION_PROMPT_DRAFTING) and proposes narration/dialogue/
  // musicPrompt/sfxPrompt per scene, grounded in what the assembled picture
  // actually shows/says rather than each scene's written description in
  // isolation. Supersedes AUDIO_PLANNING's blind per-scene music/sfx
  // planning — see draftAudioCuePlan in lib/audio-cue-plan.ts. AUDIO_PLANNING
  // itself stays in this enum (Postgres can't drop an enum value without a
  // riskier create-new-type/swap/drop-old-type migration) but nothing calls
  // it anymore.
  AUDIO_CUE_PLANNING
}

model AiModelOption {
  id      String    @id @default(cuid())
  jobType AiJobType

  provider    String
  modelId     String
  displayName String
  isDefault   Boolean @default(false)
  isEnabled   Boolean @default(true)
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_model_options")
}
