generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Project system
// ─────────────────────────────────────────────────────────────────────────

enum ProjectType {
  SINGLE
  SERIES
}

model Project {
  id        String      @id @default(cuid())
  name      String
  type      ProjectType

  // Phase 4 — the one narrator voice for this whole project, same reasoning
  // as Character.voiceName (free text, provider-specific catalog). Kept at
  // Project rather than Scene so narration sounds like the same narrator in
  // every scene/episode instead of drifting take to take — the project owner
  // asked for character/narrator voices to stay consistent across an entire
  // story, not vary per scene.
  narratorVoiceName String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  story      Story?
  storyBible StoryBible?
  seasons    Season[]
  characters Character[]
  locations  Location[]

  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────
// Story engine (Single Video)
// ─────────────────────────────────────────────────────────────────────────

model Story {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topic           String?
  premise         String?  @db.Text
  genre           String?
  tone            String?
  language        String?
  duration        String?
  narrationStyle  String?
  openingStyle    String?
  closingStyle    String?

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  scenes Scene[]

  // Phase 6 — rendered final-video attempts (ffmpeg assembly of every scene's
  // selected visual + audio, in order). Own relation/FK, same reasoning as
  // Scene.videoClips/Asset.videoSceneId: a separate concern from any other
  // Asset relation on this model.
  finalVideos Asset[] @relation("StoryFinalVideo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stories")
}

// ─────────────────────────────────────────────────────────────────────────
// Story Bible (Series)
// ─────────────────────────────────────────────────────────────────────────

model StoryBible {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  premise       String? @db.Text
  genre         String?
  tone          String?
  language      String?
  worldRules    String? @db.Text
  visualStyle   String? @db.Text
  timelineNotes String? @db.Text

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("story_bibles")
}

// ─────────────────────────────────────────────────────────────────────────
// Series structure: Seasons → Episodes
// ─────────────────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number    Int
  title     String?

  episodes  Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@map("seasons")
}

model Episode {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  number  Int
  title   String?
  summary String? @db.Text

  scenes Scene[]

  // Phase 6 — same reasoning as Story.finalVideos above.
  finalVideos Asset[] @relation("EpisodeFinalVideo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, number])
  @@map("episodes")
}

// ─────────────────────────────────────────────────────────────────────────
// Scene Engine (Phase 2) — breaks a Story (single video) or Episode (series)
// into ordered scenes. Plain-CRUD, not versioned: restoring a Version would
// mean deleting/recreating rows, which would orphan Assets that Phase 3
// later attaches via sceneId. Dual-optional FK mirrors Asset's
// characterId/locationId pattern — enforced at the API layer, not the DB.
// ─────────────────────────────────────────────────────────────────────────

enum SceneVisualMode {
  ILLUSTRATION
  IMAGE_TO_VIDEO
  TEXT_TO_VIDEO
}

// Phase 6 — a deterministic Ken Burns-style pan/zoom applied to ILLUSTRATION
// scenes at assembly time (plain ffmpeg, no AI call), not a prompt: the set
// of movements is small and enumerable, unlike motionPrompt/videoPrompt
// below which describe AI-generated motion for IMAGE_TO_VIDEO/TEXT_TO_VIDEO.
enum SceneCameraMovement {
  STATIC
  ZOOM_IN
  ZOOM_OUT
  PAN_LEFT
  PAN_RIGHT
  PAN_UP
  PAN_DOWN
}

model Scene {
  id String @id @default(cuid())

  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  order       Int
  title       String?
  description String @db.Text

  visualMode       SceneVisualMode @default(ILLUSTRATION)
  visualModeReason String?         @db.Text

  // Phase 6 — see SceneCameraMovement above. Only meaningful when
  // visualMode is ILLUSTRATION; ignored by assembly otherwise.
  cameraMovement SceneCameraMovement @default(STATIC)

  // Phase 4 — the narrator's spoken script for this scene, manually written
  // (mirrors Episode.summary: no AI-drafting step, only text-to-speech).
  narration String? @db.Text

  // Phase 5 — user-written camera/motion direction for IMAGE_TO_VIDEO scenes,
  // same manual-only pattern as narration (no AI-drafting step). Falls back
  // to `description` at generation time when unset.
  motionPrompt String? @db.Text
  // Desired clip length in seconds, user-set. Provider-specific bounds are
  // enforced at generation time, not in the schema.
  videoDurationSeconds Int?

  // Phase 5 — user-written prompt for TEXT_TO_VIDEO scenes, generated with no
  // source image at all. Kept separate from motionPrompt (which describes
  // motion layered on top of an existing image for IMAGE_TO_VIDEO) since a
  // text-to-video prompt has to carry the whole shot on its own. Falls back
  // to `description` at generation time when unset, same as motionPrompt.
  videoPrompt String? @db.Text

  // Phase 7 — the "Audio Plan" step: AI-drafted (via AUDIO_PLANNING), then
  // user-editable before the actual MUSIC_GENERATION/SFX_GENERATION call, same
  // pattern as visualModeReason (AI proposes, user can overwrite). Kept as two
  // separate fields, not one combined prompt, since music and sfx are
  // generated independently (different job types, different Asset relations
  // below) and a scene may want only one of the two. An empty prompt means
  // "don't generate this" — generation is blocked on blank, same idiom as
  // Scene.narration in voice.ts.
  musicPrompt String? @db.Text
  sfxPrompt   String? @db.Text
  // Mix levels applied at Phase 6 assembly time (0-1, relative to the voice
  // track which always plays at full volume). Defaults keep music
  // unobtrusive under dialogue/narration and sfx clearly audible.
  musicVolume Float @default(0.25)
  sfxVolume   Float @default(0.8)

  characters    Character[]
  locations     Location[]
  // Phase 3's generated scene images. Named (not just typed) Asset[] because
  // Phase 4 adds a second, separate Asset relation below (narrationAudio) —
  // Prisma requires explicit @relation names once two relations connect the
  // same two models, so it can't stay unnamed. Deliberately NOT reused for
  // narration audio: every consumer of this relation (SCENE_INCLUDE,
  // mapSceneImages, the scene-manager.tsx image gallery) treats every row
  // here as a displayable image with no type filter — mixing audio in would
  // render broken <img> tags and get swept into image select/delete calls.
  images Asset[] @relation("SceneImages")

  // Phase 4 — narration audio takes, kept on its own FK/relation rather than
  // reusing images' sceneId (see comment above).
  narrationAudio Asset[] @relation("SceneNarrationAudio")

  dialogueLines DialogueLine[]

  // Phase 5 — generated video clips (IMAGE_TO_VIDEO scenes only), same
  // separate-relation reasoning as narrationAudio: mixing clips into `images`
  // would break the image gallery's <img>-only assumption.
  videoClips Asset[] @relation("SceneVideoClips")

  // Phase 7 — background music bed and sound-effect takes, one selected slot
  // each (same take-history/isSelected pattern as narrationAudio), own
  // relations for the same reason narrationAudio/videoClips are separate from
  // `images`.
  music Asset[] @relation("SceneMusic")
  sfx   Asset[] @relation("SceneSfx")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, order])
  @@unique([episodeId, order])
  @@map("scenes")
}

// ─────────────────────────────────────────────────────────────────────────
// Character reference system
// ─────────────────────────────────────────────────────────────────────────

model Character {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  identity       String? @db.Text
  appearance     String? @db.Text
  personality    String? @db.Text
  clothing       String? @db.Text
  background     String? @db.Text
  characterArc   String? @db.Text
  isLocked       Boolean @default(false)

  // Phase 4 — free-text TTS voice name/id (e.g. "alloy"), not a fixed enum:
  // the set of valid voices is provider/model-specific and changes over
  // time, so this is user-entered rather than hardcoded, same reasoning as
  // AiModelOption not hardcoding model ids. Null falls back to whatever
  // voice the user picks at generation time.
  voiceName String?

  referenceImages Asset[]
  scenes          Scene[]
  dialogueLines   DialogueLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("characters")
}

// ─────────────────────────────────────────────────────────────────────────
// Location reference system
// ─────────────────────────────────────────────────────────────────────────

model Location {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  architecture String? @db.Text
  environment String? @db.Text
  timeWeather String?
  visualStyle String? @db.Text

  referenceImages Asset[]
  scenes          Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

// ─────────────────────────────────────────────────────────────────────────
// Voice pipeline (Phase 4) — dialogue lines are the per-Character spoken
// content within a Scene, distinct from Scene.narration (the narrator's
// script). Ordered like Scene itself; each line gets its own audio takes via
// Asset.dialogueLineId, so takes for one line never collide with another
// line's takes in the same scene the way a single shared column would.
// ─────────────────────────────────────────────────────────────────────────

model DialogueLine {
  id String @id @default(cuid())

  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  order Int
  text  String @db.Text

  audio Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@map("dialogue_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Asset library. Phase 0+1 only stored reference images; Phase 3 adds
// GENERATED_IMAGE (scene images produced by the Image pipeline, via sceneId);
// Phase 4 adds AUDIO_NARRATION (via its own narrationSceneId FK, kept
// separate from sceneId so narration takes never show up in the image
// gallery) and AUDIO_DIALOGUE (via dialogueLineId). Phase 7 adds MUSIC (via
// musicSceneId) and SFX (via sfxSceneId) — both AI-generated (through
// OpenRouter's general /chat/completions audio-output modality, since it has
// no dedicated music/SFX endpoint the way images/speech/video do) or
// user-uploaded, same dual path as GENERATED_IMAGE.
// ─────────────────────────────────────────────────────────────────────────

enum AssetType {
  REFERENCE_IMAGE
  GENERATED_IMAGE
  VIDEO_CLIP
  AUDIO_NARRATION
  AUDIO_DIALOGUE
  SFX
  MUSIC
  // Phase 6 — a fully assembled Story/Episode render (ffmpeg-stitched scenes).
  FINAL_VIDEO
}

model Asset {
  id   String    @id @default(cuid())
  type AssetType

  storageKey String
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  metadata   Json?

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  sceneId String?
  scene   Scene?  @relation("SceneImages", fields: [sceneId], references: [id], onDelete: Cascade)

  narrationSceneId String?
  narrationScene   Scene? @relation("SceneNarrationAudio", fields: [narrationSceneId], references: [id], onDelete: Cascade)

  dialogueLineId String?
  dialogueLine   DialogueLine? @relation(fields: [dialogueLineId], references: [id], onDelete: Cascade)

  // Phase 5 — generated video clips, kept on their own FK/relation for the
  // same reason narrationAudio is (see Scene.videoClips comment).
  videoSceneId String?
  videoScene   Scene? @relation("SceneVideoClips", fields: [videoSceneId], references: [id], onDelete: Cascade)

  // Phase 7 — background music / sfx takes, own FK/relation pair each, same
  // reasoning as videoSceneId above.
  musicSceneId String?
  musicScene   Scene? @relation("SceneMusic", fields: [musicSceneId], references: [id], onDelete: Cascade)

  sfxSceneId String?
  sfxScene   Scene? @relation("SceneSfx", fields: [sfxSceneId], references: [id], onDelete: Cascade)

  // Phase 5 — which selected GENERATED_IMAGE this clip was generated from,
  // for traceability when a scene's image is later regenerated/reselected.
  // Self-relation, so it needs its own name and no onDelete cascade action
  // conflict with the other Asset relations above.
  sourceImageId String?
  sourceImage   Asset?  @relation("VideoSourceImage", fields: [sourceImageId], references: [id], onDelete: SetNull)
  clipsFromThisImage Asset[] @relation("VideoSourceImage")

  // Phase 6 — assembled final-video attempts, kept on their own FK/relation
  // for the same reason videoSceneId is (see Scene.videoClips comment).
  // Dual-optional, mirroring Scene's storyId/episodeId pattern: a FINAL_VIDEO
  // asset belongs to exactly one of Story or Episode, enforced at the API
  // layer, not the DB.
  storyVideoId String?
  storyVideo   Story? @relation("StoryFinalVideo", fields: [storyVideoId], references: [id], onDelete: Cascade)

  episodeVideoId String?
  episodeVideo   Episode? @relation("EpisodeFinalVideo", fields: [episodeVideoId], references: [id], onDelete: Cascade)

  // Generation metadata — meaningful for AI-produced assets (GENERATED_IMAGE,
  // AUDIO_NARRATION, AUDIO_DIALOGUE). isSelected mirrors Version.isSelected:
  // newest generation always becomes selected, older attempts stay browsable,
  // scoped to whichever FK (sceneId+type, narrationSceneId, or
  // dialogueLineId) identifies the "slot" being regenerated. createdBy
  // defaults to USER so existing REFERENCE_IMAGE upload routes don't need
  // changes.
  isSelected Boolean   @default(false)
  prompt     String?   @db.Text
  modelId    String?
  createdBy  CreatedBy @default(USER)

  // Advisory-only consistency check against locked character/location
  // reference images. null = not validated (e.g. no reference image existed
  // to compare against) — never treated as a failure.
  validationPassed  Boolean?
  validationNotes   String?  @db.Text
  validationModelId String?

  createdAt DateTime @default(now())

  @@map("assets")
}

// ─────────────────────────────────────────────────────────────────────────
// Generic versioning — reused across Story, StoryBible, and (later) Scene,
// Character, Image, etc. entityType + entityId instead of a table per kind.
// ─────────────────────────────────────────────────────────────────────────

enum VersionEntityType {
  STORY
  STORY_BIBLE
}

enum CreatedBy {
  USER
  AI
}

model Version {
  id         String            @id @default(cuid())
  entityType VersionEntityType
  entityId   String

  versionNumber Int
  payload       Json
  isSelected    Boolean @default(false)

  prompt             String?  @db.Text
  modelId            String?
  generationSettings Json?
  createdBy          CreatedBy

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId])
  @@map("versions")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Model Registry — every dropdown in the app reads from this table.
// Nothing in application code should hardcode a model id.
// ─────────────────────────────────────────────────────────────────────────

enum AiJobType {
  MASTER_AI
  STORY_WRITING
  SCENE_PLANNING
  IMAGE_PROMPTS
  IMAGE_GENERATION
  IMAGE_VALIDATION
  VOICE
  // Phase 5 — image-to-video clip generation via a hosted AI video model.
  // Kept distinct from VIDEO below, which is reserved for local ffmpeg
  // assembly of the final output (a later, separate phase).
  VIDEO_GENERATION
  VIDEO
  // Phase 7 — the "Audio Plan" step: drafts Scene.musicPrompt/sfxPrompt from
  // the scene's description + style context, same shape as IMAGE_PROMPTS.
  AUDIO_PLANNING
  // Phase 7 — kept as two distinct job types (not one AUDIO_GENERATION) since
  // music and sound effects are generated independently and a provider well
  // suited to one (e.g. a music model like Lyria) isn't necessarily suited to
  // the other.
  MUSIC_GENERATION
  SFX_GENERATION
}

model AiModelOption {
  id      String    @id @default(cuid())
  jobType AiJobType

  provider    String
  modelId     String
  displayName String
  isDefault   Boolean @default(false)
  isEnabled   Boolean @default(true)
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_model_options")
}
