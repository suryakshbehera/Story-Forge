generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Project system
// ─────────────────────────────────────────────────────────────────────────

enum ProjectType {
  SINGLE
  SERIES
}

model Project {
  id        String      @id @default(cuid())
  name      String
  type      ProjectType

  // Phase 4 — the one narrator voice for this whole project, same reasoning
  // as Character.voiceName (free text, provider-specific catalog). Kept at
  // Project rather than Scene so narration sounds like the same narrator in
  // every scene/episode instead of drifting take to take — the project owner
  // asked for character/narrator voices to stay consistent across an entire
  // story, not vary per scene.
  narratorVoiceName String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  story      Story?
  storyBible StoryBible?
  seasons    Season[]
  characters Character[]
  locations  Location[]

  // Visual-style anchor — a locked reference image (mood board / style
  // plate) fed into every shot image generation call for this project,
  // alongside any character/location references, so overall visual style
  // doesn't drift generation to generation. Same "first uploaded = the
  // reference" convention as Character/Location reference images (no
  // separate select step). Project-level rather than Story/StoryBible-level
  // since style should hold across Single Video and Series alike.
  styleReferences Asset[] @relation("ProjectStyleReference")

  // Phase 9 — format shape (act structure, typical scene/shot count,
  // runtime, tone) defined once per series so a new episode drafts against
  // it instead of a blank page. Series-only, same optionality as storyBible;
  // nullable in practice for series predating this feature (routes upsert
  // rather than assuming the row exists — see SeriesBlueprint below).
  blueprint SeriesBlueprint?

  // Phase 9 — uploaded PDF/DOCX source documents kept for traceability and
  // re-parsing, one-time ingestion into StoryBible + Characters + Locations
  // + SeriesBlueprint. Own relation, same "one concern per FK" convention as
  // styleReferences above.
  sourceDocuments Asset[] @relation("ProjectSourceDocument")

  // Thumbnail shown on the project card so projects are recognizable at a
  // glance in the dashboard grid. Purely cosmetic (not fed into generation,
  // unlike styleReferences) — own relation for that reason. Modeled as a
  // to-many relation for the same "Asset owns the FK back to its parent"
  // convention as every other relation on this model, but the API enforces
  // a single-image invariant (replacing the old cover on new upload) since
  // a card only ever shows one image.
  coverImage Asset[] @relation("ProjectCoverImage")

  // Nullable rather than required: pre-auth Project rows already exist in
  // production with no owner, and at `prisma migrate deploy` time (which
  // runs before the boot-time bootstrap script upserts the admin user) a
  // NOT NULL FK would have nothing valid to point at yet. The bootstrap
  // script backfills any ownerId IS NULL row to the admin's id right after
  // upserting the admin, before `pnpm start` accepts traffic — see
  // packages/db/src/bootstrap-admin.ts. proxy.ts treats ownerId === null as
  // admin-only-accessible as a safe default; this state should never be
  // visible to end users in practice, but code must not crash if it is.
  // onDelete SetNull (not Cascade) so deleting a user account doesn't
  // silently destroy their whole project tree — there's no undo for that.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Phase 13 — per-project preferred model per job type, one resolution
  // tier above AiModelOption.isDefault (the global fallback) and one tier
  // below a per-action override where one exists (e.g. Shot.videoModelId).
  // See ProjectModelDefault below.
  modelDefaults ProjectModelDefault[]

  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────
// Story engine (Single Video)
// ─────────────────────────────────────────────────────────────────────────

model Story {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topic           String?
  premise         String?  @db.Text
  genre           String?
  tone            String?
  language        String?
  duration        String?
  narrationStyle  String?
  openingStyle    String?
  closingStyle    String?

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  scenes Scene[]

  // Phase 6 — rendered final-video attempts (ffmpeg assembly of every scene's
  // selected visual + audio, in order). Own relation/FK, same reasoning as
  // Scene.videoClips/Asset.videoSceneId: a separate concern from any other
  // Asset relation on this model.
  finalVideos Asset[] @relation("StoryFinalVideo")

  // Assemble-without-Audio — the same per-scene visual stitch as finalVideos,
  // but silent and rendered as its own persisted, user-reviewable take
  // (previously an ephemeral, low-res proxy rebuilt on every Audio Cue Plan
  // draft — see Asset.storySilentVideoId).
  silentVideos Asset[] @relation("StorySilentVideo")

  // Phase 12 — same in-flight generation lock contract as
  // Scene.narrationGenerationStartedAt above, for this story's assembly jobs.
  silentVideoGenerationStartedAt DateTime?
  finalVideoGenerationStartedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stories")
}

// ─────────────────────────────────────────────────────────────────────────
// Story Bible (Series)
// ─────────────────────────────────────────────────────────────────────────

model StoryBible {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  premise       String? @db.Text
  genre         String?
  tone          String?
  language      String?
  worldRules    String? @db.Text
  visualStyle   String? @db.Text
  timelineNotes String? @db.Text

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("story_bibles")
}

// ─────────────────────────────────────────────────────────────────────────
// Series Blueprint (Phase 9) — format shape for the series (act structure,
// typical scene/shot count, runtime, tone), defined once so new episodes
// draft against it instead of a blank page. Structurally mirrors StoryBible
// on purpose: setup fields + versioned content, same editor/route shape,
// reached by generation calls through assembleContext() rather than a new
// call site. Free-text fields throughout, same reasoning as StoryBible/
// Story (e.g. duration) — no premature structure like a scene-count int.
// ─────────────────────────────────────────────────────────────────────────

model SeriesBlueprint {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actStructure      String? @db.Text
  sceneShotGuidance String? @db.Text
  runtimeTarget     String?
  tone              String?

  // Currently-selected content — denormalized copy of the selected Version's payload.
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("series_blueprints")
}

// ─────────────────────────────────────────────────────────────────────────
// Series structure: Seasons → Episodes
// ─────────────────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number    Int
  title     String?

  episodes  Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@map("seasons")
}

model Episode {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  number  Int
  title   String?
  summary String? @db.Text

  scenes Scene[]

  // Phase 6 — same reasoning as Story.finalVideos above.
  finalVideos Asset[] @relation("EpisodeFinalVideo")

  // Same reasoning as Story.silentVideos above.
  silentVideos Asset[] @relation("EpisodeSilentVideo")

  // Same in-flight generation lock contract as Story's fields above.
  silentVideoGenerationStartedAt DateTime?
  finalVideoGenerationStartedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, number])
  @@map("episodes")
}

// ─────────────────────────────────────────────────────────────────────────
// Scene Engine (Phase 2) — breaks a Story (single video) or Episode (series)
// into ordered scenes. Plain-CRUD, not versioned: restoring a Version would
// mean deleting/recreating rows, which would orphan Assets that Phase 3
// later attaches via sceneId. Dual-optional FK mirrors Asset's
// characterId/locationId pattern — enforced at the API layer, not the DB.
// ─────────────────────────────────────────────────────────────────────────

enum SceneVisualMode {
  ILLUSTRATION
  IMAGE_TO_VIDEO
  TEXT_TO_VIDEO
}

model Scene {
  id String @id @default(cuid())

  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  order       Int
  title       String?
  description String @db.Text

  // Temporal memory (scene-to-scene) — the world's state as SHOT_PLANNING
  // resolved it at the end of this scene, for whatever categories don't
  // already live on Shot: environment (location/time/weather/lighting),
  // unfinished actions, spatial layout, hard continuity anchors, and the
  // cause->effect story state. Character/object state is deliberately NOT
  // duplicated here — that's already carried via the scene's last Shot's
  // continuity/continuityNotes (see scene-continuity.ts), which this
  // complements rather than replaces. Untyped Json?, same "AI-response
  // boundary" posture as Shot.continuity: parsed defensively, never trusted.
  // Drafted by the same SHOT_PLANNING call that plans this scene's shots (no
  // extra model call), consumed by the NEXT scene's SHOT_PLANNING prompt.
  closingState Json?

  visualMode       SceneVisualMode @default(ILLUSTRATION)
  visualModeReason String?         @db.Text

  // Phase 4 — the narrator's spoken script for this scene, manually written
  // (mirrors Episode.summary: no AI-drafting step, only text-to-speech).
  narration String? @db.Text

  // Delivery direction for `narration` — mirrors DialogueLine.deliveryNotes/
  // speed exactly (same TTS instructions/speed passthrough in voice.ts, same
  // AI-proposes-then-user-can-overwrite idiom via NARRATION_DIRECTION, one
  // level up from DIALOGUE_DIRECTION's per-line version). Unlike `narration`
  // itself, these two *do* have an AI-drafting step — narration text stays
  // manual-only.
  narrationDeliveryNotes String? @db.Text
  narrationSpeed         Float?

  // Phase 5 — user-written camera/motion direction for IMAGE_TO_VIDEO scenes,
  // same manual-only pattern as narration (no AI-drafting step). Falls back
  // to `description` at generation time when unset.
  motionPrompt String? @db.Text
  // Desired clip length in seconds, user-set. Provider-specific bounds are
  // enforced at generation time, not in the schema. When unset, generation
  // falls back to the scene's actual narration+dialogue audio length (see
  // getSceneVoiceDurationSeconds in scene-audio.ts) as the target duration.
  videoDurationSeconds Int?
  // Resolution override (e.g. "720p"); falls back to the chosen model's
  // default resolution (AiModelOption.config.resolutions[0]) when unset.
  videoResolution String?
  // Whether to request the model's own native audio track alongside the
  // video (OpenRouter's generate_audio param). Off by default: narration,
  // music, and sfx are always generated separately and layered in at
  // assembly time (see video-assembly.ts), so native audio is opt-in extra.
  videoGenerateAudio Boolean @default(false)

  // Phase 5 — user-written prompt for TEXT_TO_VIDEO scenes, generated with no
  // source image at all. Kept separate from motionPrompt (which describes
  // motion layered on top of an existing image for IMAGE_TO_VIDEO) since a
  // text-to-video prompt has to carry the whole shot on its own. Falls back
  // to `description` at generation time when unset, same as motionPrompt.
  videoPrompt String? @db.Text

  // Phase 7 — the "Audio Plan" step: AI-drafted (via AUDIO_PLANNING), then
  // user-editable before the actual MUSIC_GENERATION/SFX_GENERATION call, same
  // pattern as visualModeReason (AI proposes, user can overwrite). Kept as two
  // separate fields, not one combined prompt, since music and sfx are
  // generated independently (different job types, different Asset relations
  // below) and a scene may want only one of the two. An empty prompt means
  // "don't generate this" — generation is blocked on blank, same idiom as
  // Scene.narration in voice.ts.
  musicPrompt String? @db.Text
  sfxPrompt   String? @db.Text
  // Mix levels applied at Phase 6 assembly time (0-1, relative to the voice
  // track which always plays at full volume). Defaults keep music
  // unobtrusive under dialogue/narration and sfx clearly audible.
  musicVolume Float @default(0.25)
  sfxVolume   Float @default(0.8)

  characters    Character[]
  locations     Location[]

  // Phase 8 — the scene's ordered shots, each carrying its own images (and,
  // for ILLUSTRATION scenes, its own camera movement). Scene stopped being
  // the image unit — see Shot below.
  shots Shot[]

  // Phase 4 — narration audio takes, kept on its own FK/relation rather than
  // reusing images' sceneId (see comment above).
  narrationAudio Asset[] @relation("SceneNarrationAudio")

  dialogueLines DialogueLine[]

  // Phase 5 — generated video clips (IMAGE_TO_VIDEO scenes only), same
  // separate-relation reasoning as narrationAudio: mixing clips into `images`
  // would break the image gallery's <img>-only assumption.
  videoClips Asset[] @relation("SceneVideoClips")

  // Phase 7 — background music bed and sound-effect takes, one selected slot
  // each (same take-history/isSelected pattern as narrationAudio), own
  // relations for the same reason narrationAudio/videoClips are separate from
  // `images`.
  music Asset[] @relation("SceneMusic")
  sfx   Asset[] @relation("SceneSfx")

  // Phase 12 — in-flight generation locks, same contract as
  // Shot.imageGenerationStartedAt below: stamped right before a call starts,
  // cleared in a finally once it ends (success or failure either way), and
  // treated as stale (i.e. nothing is actually running) past each job's own
  // staleness threshold in lib/generation-claims.ts — a crashed request can't
  // block that slot forever. One field per independently-generated slot on
  // this model, mirroring musicPrompt/sfxPrompt already being separate.
  narrationGenerationStartedAt DateTime?
  videoGenerationStartedAt     DateTime?
  musicGenerationStartedAt     DateTime?
  sfxGenerationStartedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, order])
  @@unique([episodeId, order])
  @@map("scenes")
}

// ─────────────────────────────────────────────────────────────────────────
// Shot Engine (Phase 8) — subdivides a Scene into an ordered sequence of
// distinct visual compositions. Each Shot is its own continuity frame — shot
// 2 continues the story from shot 1, it is not an alternate take of it.
// Alternates only exist *within* one Shot's own image gallery, the same
// isSelected take-history pattern Scene.images used to have. Scene stopped
// being the image unit and became a pure container (narrative description,
// tags, audio, music); Shots underneath now carry the visuals. Plain-CRUD,
// not versioned — same reasoning as Scene itself.
// ─────────────────────────────────────────────────────────────────────────

// Purely additive since the original 7: DOLLY/TRACK/CRANE/HANDHELD were added
// once Director AI made the zoom-vs-dolly distinction expressible ("slow
// push-in" is a dolly, not a zoom — the camera physically translates, which
// changes perspective and parallax; a zoom only changes field of view). The
// original 7 values are never renamed or removed: they're already stored on
// live Shot rows and inside live AiModelOption.config.preferredCameraMovements
// JSON, which is untyped and would silently stop matching on a rename.
//
// ILLUSTRATION scenes render these as ffmpeg Ken Burns moves over a still
// (buildCameraFilter, video-assembly.ts), where a dolly and a zoom are
// necessarily the same affine transform; IMAGE_TO_VIDEO scenes send them as
// prose to a video model (cameraMovementInstruction, scene-video.ts), where
// the distinction is real and worth expressing.
// Grouped by family, not alphabetically — this order is what the shot editor
// dropdown and the model-routing checkboxes render in.
//
// PAN_UP/PAN_DOWN were renamed to TILT_UP/TILT_DOWN (a pan is horizontal
// rotation; vertical rotation is a tilt) via ALTER TYPE … RENAME VALUE, which
// updates every stored Shot row automatically because the enum label IS the
// storage. PAN_LEFT/PAN_RIGHT keep their names — those were always correct.
// The rename does NOT reach AiModelOption.config.preferredCameraMovements,
// which holds these as plain JSON strings; the same migration rewrites those.
enum CameraMovement {
  STATIC

  // Optical — the lens changes, the camera body does not move.
  ZOOM_IN
  ZOOM_OUT
  CRASH_ZOOM

  // Translation toward/away from the subject — perspective and parallax change.
  DOLLY_IN
  DOLLY_OUT
  // Dolly and zoom in opposition: the subject holds size while the background
  // scale shifts. Not decomposable into a dolly plus a zoom, because the whole
  // effect is that they happen simultaneously and cancel.
  DOLLY_ZOOM

  // Rotation in place — the camera pivots, its position fixed.
  PAN_LEFT
  PAN_RIGHT
  WHIP_PAN
  TILT_UP
  TILT_DOWN
  ROLL

  // Lateral / vertical translation of the camera body.
  TRACK_LEFT
  TRACK_RIGHT
  // Pedestal is the camera body rising/falling on its column — parallel
  // translation. A crane arcs the viewpoint through space on an arm, and a
  // tilt merely rotates without moving. Three different shots.
  PEDESTAL_UP
  PEDESTAL_DOWN
  CRANE_UP
  CRANE_DOWN

  // Circular travel around the subject.
  ARC_LEFT
  ARC_RIGHT

  // Texture / platform rather than a direction of travel.
  STEADICAM_FOLLOW
  HANDHELD
  AERIAL
}

// ── Director AI cinematography vocabulary ────────────────────────────────
// Resolved per shot by SHOT_PLANNING (or the backfill pass,
// directExistingShots in lib/shots.ts) and rendered into the image prompt by
// buildCameraDirectionBlock (lib/shot-images.ts). Every one of the columns
// below is nullable with NO default, deliberately: null means "the Director
// said nothing about this, let the image model decide", which is different
// from — and better than — defaulting every shot to a bland eye-level
// medium. A default would silently flatten every shot in the product into
// the same look; null keeps the prompt silent on that axis instead.
//
// Enums are closed vocabularies (a fixed film-grammar term list the UI can
// offer as a dropdown); the two free-text columns (focusPoint,
// subjectMovement) stay prose for the same reason Character.appearance does
// — no useful closed set exists for "what the eye should land on".

enum ShotSize {
  EXTREME_WIDE
  WIDE
  FULL
  MEDIUM
  MEDIUM_CLOSE_UP
  CLOSE_UP
  EXTREME_CLOSE_UP
}

enum CameraAngle {
  EYE_LEVEL
  LOW
  HIGH
  OVERHEAD
  DUTCH
  OVER_THE_SHOULDER
  POV
}

enum ShotFraming {
  SINGLE
  TWO_SHOT
  THREE_SHOT
  GROUP
  INSERT
  ESTABLISHING
}

enum DepthOfField {
  SHALLOW
  MEDIUM
  DEEP
}

enum LightingStyle {
  NATURAL
  SOFT
  HARD
  HIGH_KEY
  LOW_KEY
  BACKLIT
  SILHOUETTE
  GOLDEN_HOUR
  MOONLIT
  PRACTICAL
}

enum ShotComposition {
  CENTERED
  RULE_OF_THIRDS
  SYMMETRICAL
  LEADING_LINES
  FRAME_WITHIN_FRAME
  NEGATIVE_SPACE
  DIAGONAL
}

// Director AI emotion vocabulary — same "curated closed set, not an
// unbounded label list" reasoning as CameraMovement: a model given 100
// near-synonyms clusters on 3-4 "safe" ones, one given ~35 clearly
// distinguished ones actually discriminates. Nuance beyond this vocabulary
// belongs in Shot.facialExpression/bodyLanguage (prose), not in more enum
// values — mirrors focusPoint/subjectMovement sitting alongside ShotSize/
// CameraAngle.
enum Emotion {
  JOY
  LOVE
  HOPE
  PRIDE
  RELIEF
  SADNESS
  GRIEF
  LONELINESS
  DESPAIR
  NOSTALGIA
  ANGER
  RAGE
  FRUSTRATION
  RESENTMENT
  FEAR
  ANXIETY
  DREAD
  PANIC
  SURPRISE
  SHOCK
  AWE
  CONFUSION
  CURIOSITY
  SHAME
  GUILT
  JEALOUSY
  BETRAYAL
  DESIRE
  DETERMINATION
  COURAGE
  DEFIANCE
  TRIUMPH
  SUSPENSE
  CALM
  DOUBT
  EXHAUSTION
}

// How strongly the emotion reads, not how long it lasts. Three tiers, same
// granularity as DepthOfField — a model asked for a percentage clusters on
// round numbers; asked to pick a tier, it actually commits to one.
enum EmotionIntensity {
  SUBTLE
  MODERATE
  INTENSE
}

model Shot {
  id String @id @default(cuid())

  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  order       Int
  description String @db.Text

  // Free-text note of what changed by the end of this shot (props picked up/
  // dropped, wardrobe or physical-condition changes, etc.) — AI-drafted at
  // SHOT_PLANNING time, user-editable after. Read by the NEXT shot
  // (order + 1) in generateShotImage for continuity, same "prose with
  // canonical names" convention as Character.appearance/Location.description.
  continuityNotes String? @db.Text

  // Resolved continuity snapshot: a JSON array of { subject, state } entries
  // stating what IS true as of this shot for any character/prop/location
  // whose state differs from its bible baseline — not a diff of what changed.
  // AI-drafted at SHOT_PLANNING time (same call as continuityNotes, no extra
  // model call), instructed to carry forward every still-true entry from
  // earlier shots in the same scene. Deliberately a snapshot, not a diff
  // chain: a diff-only note (continuityNotes) requires replaying every prior
  // shot correctly to reconstruct current state, which is where drift
  // compounds — a snapshot is self-contained. Read by the NEXT shot the same
  // way continuityNotes is; the two fields serve different readers
  // (continuityNotes is the short human-editable summary, continuity is the
  // structured machine-consumed state).
  continuity Json?

  // ILLUSTRATION scenes: each shot's image is held via Ken Burns for its own
  // explicit duration in this direction, then concatenated in order (see
  // durationSeconds below — the picture's timing no longer derives from
  // scene audio). IMAGE_TO_VIDEO scenes: each consecutive shot pair
  // (shot[i]->shot[i+1]) generates its own clip using the pair's two images
  // as start/end keyframes, and the starting shot's cameraMovement is
  // surfaced as an explicit camera instruction in that pair's prompt (see
  // cameraMovementInstruction() in scene-video.ts) — free-text prompts alone
  // get inconsistent camera-motion adherence across providers. TEXT_TO_VIDEO
  // scenes don't use shots at all (no source image to speak of).
  cameraMovement CameraMovement @default(STATIC)

  // Optional explicit length. ILLUSTRATION (Phase 11+): the picture is
  // authoritative and voice is fit to it afterward (see buildSceneSegment in
  // video-assembly.ts) — shots left unset fall back to a flat
  // DEFAULT_ILLUSTRATION_SECONDS each (lib/illustration-timing.ts), *not* a
  // split of the scene's audio length; generateShots (lib/shots.ts) seeds a
  // rough word-count-based split only when the scene already has narration/
  // dialogue text at shot-planning time. IMAGE_TO_VIDEO: read as "how long
  // the clip leaving this shot should run" (the pair shot[i]->shot[i+1]);
  // shots left unset evenly split the scene's target duration across its
  // pairs (see splitFixedDurations in video-segmentation.ts).
  durationSeconds Int?

  // IMAGE_TO_VIDEO only — manual per-shot override of which VIDEO_GENERATION
  // AiModelOption.id generates this shot's pair (shot[i]->shot[i+1], keyed
  // by the pair's starting shot). Unset falls back to a CameraMovement-based
  // preferred-model rule (AiModelOption.config.preferredCameraMovements),
  // then to the scene's own default model — see resolvePairModel() in
  // scene-video.ts. No relation (same reasoning as Asset.modelId): the
  // referenced AiModelOption can be edited/deleted independently, and a
  // dangling id is just treated as unset.
  videoModelId String?

  // ── Director AI cinematography (all nullable, no defaults — see the enum
  // block above for why "null means silent, not bland"). Drafted by
  // SHOT_PLANNING in the same call as description/continuity (no extra model
  // call), user-editable in the Cinematography block of shot-manager.tsx,
  // and read at IMAGE_PROMPTS time by buildCameraDirectionBlock. Lighting is
  // held across a scene by default and camera angle must respect the scene's
  // 180-degree axis — both are enforced by instruction in the per-scene
  // planning prompt, not by a constraint here, since a deliberate lighting
  // change mid-scene (a door opens, a lamp dies) is legitimate.
  shotSize     ShotSize?
  // Focal length in mm, clamped 8-300 on ingest. Free int rather than an
  // enum: lens choice is genuinely continuous, and a model that says "85"
  // shouldn't be forced into a nearest-bucket lie.
  lensMm       Int?
  cameraAngle  CameraAngle?
  framing      ShotFraming?
  depthOfField DepthOfField?
  // What the eye should land on ("Arjun's hands on the hilt") — prose, since
  // no useful closed vocabulary exists for this.
  focusPoint   String?      @db.Text
  lightingStyle LightingStyle?
  composition   ShotComposition?
  // Subject motion *within* the frame, including screen direction ("Arjun
  // strides in from frame-left") — distinct from cameraMovement, which is
  // what the camera does. Prose for the same reason as focusPoint; screen
  // direction in particular has no closed set once more than one subject
  // moves.
  subjectMovement String? @db.Text

  // ── Director AI emotion (same rules as cinematography above: nullable, no
  // defaults, null means silent not bland). Drafted by SHOT_PLANNING in the
  // same call as description/continuity/cinematography (no extra model
  // call), read at IMAGE_PROMPTS time (buildEmotionDirectionBlock in
  // shot-images.ts) and by Voice direction (generateNarrationDirection/
  // generateDialogueDirection in voice.ts) as scene-level emotional-arc
  // context — there is no Shot<->DialogueLine link, so Voice reads the
  // scene's shots as an ordered arc rather than a per-line binding.
  emotion          Emotion?
  emotionIntensity EmotionIntensity?
  // Prose, same reasoning as focusPoint/subjectMovement: no useful closed
  // vocabulary exists for a specific expression ("eyes widen, jaw tight").
  facialExpression String?           @db.Text
  bodyLanguage     String?           @db.Text

  images Asset[] @relation("ShotImages")

  // Set right before an image-generation call starts, cleared in a finally
  // once it ends (success or failure) — lets the UI show a persisted
  // "Generating…" state across a page reload and lets the API reject a
  // second concurrent generate call as a duplicate. Treated as stale (i.e.
  // no generation is actually running) once older than the API route's
  // IMAGE_GENERATION_STALE_MS, so a crashed request can't leave this stuck
  // forever — see /api/shots/[id]/images/generate.
  imageGenerationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@map("shots")
}

// ─────────────────────────────────────────────────────────────────────────
// Character reference system
// ─────────────────────────────────────────────────────────────────────────

model Character {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  identity       String? @db.Text
  // Free-text like the other bible fields ("17", "mid-30s", "looks older
  // than her 20 years") — an int couldn't capture age-presentation, which is
  // what actually drifts shot-to-shot without a reference image to pin it.
  age            String? @db.Text
  appearance     String? @db.Text
  personality    String? @db.Text
  clothing       String? @db.Text
  background     String? @db.Text
  characterArc   String? @db.Text
  isLocked       Boolean @default(false)

  // Phase 4 — free-text TTS voice name/id (e.g. "alloy"), not a fixed enum:
  // the set of valid voices is provider/model-specific and changes over
  // time, so this is user-entered rather than hardcoded, same reasoning as
  // AiModelOption not hardcoding model ids. Null falls back to whatever
  // voice the user picks at generation time.
  voiceName String?

  referenceImages Asset[]
  scenes          Scene[]
  dialogueLines   DialogueLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("characters")
}

// ─────────────────────────────────────────────────────────────────────────
// Location reference system
// ─────────────────────────────────────────────────────────────────────────

model Location {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  architecture String? @db.Text
  environment String? @db.Text
  timeWeather String?
  visualStyle String? @db.Text

  referenceImages Asset[]
  scenes          Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

// ─────────────────────────────────────────────────────────────────────────
// Voice pipeline (Phase 4) — dialogue lines are the per-Character spoken
// content within a Scene, distinct from Scene.narration (the narrator's
// script). Ordered like Scene itself; each line gets its own audio takes via
// Asset.dialogueLineId, so takes for one line never collide with another
// line's takes in the same scene the way a single shared column would.
// ─────────────────────────────────────────────────────────────────────────

model DialogueLine {
  id String @id @default(cuid())

  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  order Int
  text  String @db.Text

  // Phase 8 — "direction" for this line: AI-drafted (via DIALOGUE_DIRECTION,
  // one call per scene so a conversation's emotional beats stay coherent
  // across lines), then user-editable, same AI-drafts/user-edits pattern as
  // visualModeReason/musicPrompt. Both map to real, documented OpenAI-
  // compatible TTS params — deliveryNotes to `instructions`, speed to
  // `speed` — passed through in generateDialogueAudio() (lib/voice.ts).
  deliveryNotes String? @db.Text
  speed         Float?

  audio Asset[]

  // Phase 12 — same in-flight generation lock contract as
  // Scene.narrationGenerationStartedAt above, for this line's own voice call.
  audioGenerationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@map("dialogue_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Asset library. Phase 0+1 only stored reference images; Phase 3 adds
// GENERATED_IMAGE (originally scene images via sceneId, now shot images via
// shotId — see Shot model, Phase 8); Phase 4 adds AUDIO_NARRATION (via its
// own narrationSceneId FK, kept
// separate from sceneId so narration takes never show up in the image
// gallery) and AUDIO_DIALOGUE (via dialogueLineId). Phase 7 adds MUSIC (via
// musicSceneId) and SFX (via sfxSceneId) — both AI-generated (through
// OpenRouter's general /chat/completions audio-output modality, since it has
// no dedicated music/SFX endpoint the way images/speech/video do) or
// user-uploaded, same dual path as GENERATED_IMAGE.
// ─────────────────────────────────────────────────────────────────────────

enum AssetType {
  REFERENCE_IMAGE
  GENERATED_IMAGE
  VIDEO_CLIP
  AUDIO_NARRATION
  AUDIO_DIALOGUE
  SFX
  MUSIC
  // Phase 6 — a fully assembled Story/Episode render (ffmpeg-stitched scenes).
  FINAL_VIDEO
  // Assemble-without-Audio — every scene's selected visual stitched together
  // with no voice/music/sfx layered in, at full resolution. Persisted and
  // user-reviewable, unlike the ephemeral proxy it replaces.
  SILENT_VIDEO
  // Phase 9 — an uploaded PDF/DOCX parsed into StoryBible + Characters +
  // Locations + SeriesBlueprint. Kept after parsing for traceability/re-runs.
  SOURCE_DOCUMENT
}

model Asset {
  id   String    @id @default(cuid())
  type AssetType

  storageKey String
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  metadata   Json?

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Phase 8 — a shot's own generated/uploaded image attempts, one selected
  // at a time (same isSelected take-history pattern as narrationAudio).
  shotId String?
  shot   Shot?   @relation("ShotImages", fields: [shotId], references: [id], onDelete: Cascade)

  narrationSceneId String?
  narrationScene   Scene? @relation("SceneNarrationAudio", fields: [narrationSceneId], references: [id], onDelete: Cascade)

  dialogueLineId String?
  dialogueLine   DialogueLine? @relation(fields: [dialogueLineId], references: [id], onDelete: Cascade)

  // Phase 5 — generated video clips, kept on their own FK/relation for the
  // same reason narrationAudio is (see Scene.videoClips comment).
  videoSceneId String?
  videoScene   Scene? @relation("SceneVideoClips", fields: [videoSceneId], references: [id], onDelete: Cascade)

  // Phase 7 — background music / sfx takes, own FK/relation pair each, same
  // reasoning as videoSceneId above.
  musicSceneId String?
  musicScene   Scene? @relation("SceneMusic", fields: [musicSceneId], references: [id], onDelete: Cascade)

  sfxSceneId String?
  sfxScene   Scene? @relation("SceneSfx", fields: [sfxSceneId], references: [id], onDelete: Cascade)

  // Phase 5 — which selected GENERATED_IMAGE this clip was generated from,
  // for traceability when a scene's image is later regenerated/reselected.
  // Self-relation, so it needs its own name and no onDelete cascade action
  // conflict with the other Asset relations above.
  sourceImageId String?
  sourceImage   Asset?  @relation("VideoSourceImage", fields: [sourceImageId], references: [id], onDelete: SetNull)
  clipsFromThisImage Asset[] @relation("VideoSourceImage")

  // Multi-segment video generation — one "Generate Video" call can produce
  // several frame-chained clips (each continuing from the previous one's
  // last frame) when the scene's target duration exceeds what the chosen
  // model can produce in a single segment. All clips from one call share a
  // videoBatchId and are ordered by videoSegmentOrder; isSelected applies to
  // the whole batch at once (every clip in the selected batch is isSelected).
  // Both null on legacy single-clip rows, which keep working unchanged.
  videoBatchId      String?
  videoSegmentOrder Int?

  // Which consecutive shot pair (0-based: 0 = shot[0]->shot[1], etc.) this
  // clip belongs to, for IMAGE_TO_VIDEO scenes generating one clip per shot
  // pair. Several clips can share the same videoPairIndex when a pair's own
  // target duration needs more than one duration-chained sub-segment (see
  // planVideoSegments) — videoSegmentOrder still orders all of them
  // correctly for assembly regardless. Null on TEXT_TO_VIDEO clips and
  // legacy single-clip/whole-scene rows predating per-pair generation.
  videoPairIndex Int?

  // Phase 6 — assembled final-video attempts, kept on their own FK/relation
  // for the same reason videoSceneId is (see Scene.videoClips comment).
  // Dual-optional, mirroring Scene's storyId/episodeId pattern: a FINAL_VIDEO
  // asset belongs to exactly one of Story or Episode, enforced at the API
  // layer, not the DB.
  storyVideoId String?
  storyVideo   Story? @relation("StoryFinalVideo", fields: [storyVideoId], references: [id], onDelete: Cascade)

  episodeVideoId String?
  episodeVideo   Episode? @relation("EpisodeFinalVideo", fields: [episodeVideoId], references: [id], onDelete: Cascade)

  // Assemble-without-Audio attempts — same dual-optional pattern as
  // storyVideoId/episodeVideoId above, for SILENT_VIDEO assets.
  storySilentVideoId String?
  storySilentVideo   Story? @relation("StorySilentVideo", fields: [storySilentVideoId], references: [id], onDelete: Cascade)

  episodeSilentVideoId String?
  episodeSilentVideo   Episode? @relation("EpisodeSilentVideo", fields: [episodeSilentVideoId], references: [id], onDelete: Cascade)

  // Project-level style anchor image — see Project.styleReferences.
  projectStyleId String?
  projectStyle   Project? @relation("ProjectStyleReference", fields: [projectStyleId], references: [id], onDelete: Cascade)

  // Phase 9 — uploaded source document (PDF/DOCX) — see Project.sourceDocuments.
  projectSourceId String?
  projectSource   Project? @relation("ProjectSourceDocument", fields: [projectSourceId], references: [id], onDelete: Cascade)

  // Project card thumbnail — see Project.coverImage.
  projectCoverId String?
  projectCover   Project? @relation("ProjectCoverImage", fields: [projectCoverId], references: [id], onDelete: Cascade)

  // Generation metadata — meaningful for AI-produced assets (GENERATED_IMAGE,
  // AUDIO_NARRATION, AUDIO_DIALOGUE). isSelected mirrors Version.isSelected:
  // newest generation always becomes selected, older attempts stay browsable,
  // scoped to whichever FK (sceneId+type, narrationSceneId, or
  // dialogueLineId) identifies the "slot" being regenerated. createdBy
  // defaults to USER so existing REFERENCE_IMAGE upload routes don't need
  // changes.
  isSelected Boolean   @default(false)
  prompt     String?   @db.Text
  modelId    String?
  createdBy  CreatedBy @default(USER)

  // Word-level speech timing for AUDIO_NARRATION/AUDIO_DIALOGUE assets —
  // JSON array of { word, startSeconds, endSeconds }, aggregated from
  // ElevenLabs' per-character with-timestamps response (lib/ai/elevenlabs.ts's
  // generateSpeechWithTimestamps). null for takes generated via Sarvam or
  // OpenRouter (neither exposes timestamps), and for every non-voice asset
  // type. Not yet consumed anywhere downstream (buildIllustrationSegment in
  // video-assembly.ts still scales shots by a uniform per-scene ratio) — that
  // needs a shot<->narration-segment link that doesn't exist yet; this column
  // only captures the data so that follow-up doesn't also need a re-generation
  // pass over every existing voice take.
  wordTimestamps Json?

  // Advisory-only consistency check against locked character/location
  // reference images. null = not validated (e.g. no reference image existed
  // to compare against) — never treated as a failure.
  validationPassed  Boolean?
  validationNotes   String?  @db.Text
  validationModelId String?

  // Advisory-only auto-QC signal for generated VIDEO_CLIP assets — currently
  // freeze/near-static detection only (see checkSegmentFrozen and
  // generatePairSegments in scene-video.ts), a local ffmpeg check, not an AI
  // call. Deliberately separate from validationPassed/validationNotes above:
  // that field checks cast/location consistency against reference images,
  // this one checks whether the clip's own motion looks broken. null = not
  // checked (e.g. a STATIC-camera shot, where looking still is the intent) —
  // never treated as a hard failure; a flagged clip is already auto-retried
  // once before being kept, so this only fires when the retry still failed.
  qcPassed Boolean?
  qcNotes  String?  @db.Text

  // Observability for IMAGE_TO_VIDEO shot-pair clips: whether this segment's
  // generateVideo call actually included the pair's end-frame keyframe
  // (OpenRouter's lastFrameDataUri) — false when the pair had no end shot,
  // the resolved model declared supportsLastFrame: false, or this wasn't the
  // pair's last sub-segment; null for TEXT_TO_VIDEO/legacy rows where the
  // concept doesn't apply. Surfaced in the Takes panel so a scene that looks
  // "off" can be diagnosed per-clip instead of guessed at — see
  // generatePairSegments in scene-video.ts.
  usedEndFrame Boolean?

  createdAt DateTime @default(now())

  @@map("assets")
}

// ─────────────────────────────────────────────────────────────────────────
// Generic versioning — reused across Story, StoryBible, and (later) Scene,
// Character, Image, etc. entityType + entityId instead of a table per kind.
// ─────────────────────────────────────────────────────────────────────────

enum VersionEntityType {
  STORY
  STORY_BIBLE
  // Phase 9 — same versioned-content pattern as STORY_BIBLE, for SeriesBlueprint.content.
  SERIES_BLUEPRINT
}

enum CreatedBy {
  USER
  AI
}

model Version {
  id         String            @id @default(cuid())
  entityType VersionEntityType
  entityId   String

  versionNumber Int
  payload       Json
  isSelected    Boolean @default(false)

  prompt             String?  @db.Text
  modelId            String?
  generationSettings Json?
  createdBy          CreatedBy

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId])
  @@map("versions")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Model Registry — every dropdown in the app reads from this table.
// Nothing in application code should hardcode a model id.
// ─────────────────────────────────────────────────────────────────────────

enum AiJobType {
  MASTER_AI
  STORY_WRITING
  SCENE_PLANNING
  IMAGE_PROMPTS
  IMAGE_GENERATION
  IMAGE_VALIDATION
  VOICE
  // Phase 5 — image-to-video clip generation via a hosted AI video model.
  // Kept distinct from VIDEO below, which is reserved for local ffmpeg
  // assembly of the final output (a later, separate phase).
  VIDEO_GENERATION
  // Tier-2 model-based quality/continuity critic for generated VIDEO_CLIP
  // assets — mirrors IMAGE_VALIDATION one step over, but judges a clip
  // (video_url input) instead of a still. One vision call per segment/pair
  // covering: (1) face/identity + reference consistency against locked
  // character/location images, (2) continuity adherence against
  // Shot.continuity/continuityNotes, (3) prompt/motion adherence (does the
  // clip's actual action match the requested camera movement). Cannot reuse
  // IMAGE_VALIDATION's model slot — its default (gpt-5.6-luna) doesn't
  // accept video input at all. Advisory-only, same posture as
  // IMAGE_VALIDATION and qcPassed: skipped entirely when unconfigured, never
  // blocks generation. See runVideoValidation in lib/scene-video.ts.
  VIDEO_VALIDATION
  VIDEO
  // Phase 7 — the "Audio Plan" step: drafts Scene.musicPrompt/sfxPrompt from
  // the scene's description + style context, same shape as IMAGE_PROMPTS.
  AUDIO_PLANNING
  // Phase 7 — kept as two distinct job types (not one AUDIO_GENERATION) since
  // music and sound effects are generated independently and a provider well
  // suited to one (e.g. a music model like Lyria) isn't necessarily suited to
  // the other.
  MUSIC_GENERATION
  SFX_GENERATION
  // Phase 8 — proposes an ordered list of Shots for one scene (mirrors
  // SCENE_PLANNING one level down: Story→Scenes becomes Scene→Shots).
  SHOT_PLANNING
  // Phase 8 — drafts DialogueLine.deliveryNotes/speed for every line in a
  // scene in one call, so a conversation's delivery stays coherent.
  DIALOGUE_DIRECTION
  // Mirrors DIALOGUE_DIRECTION one level up: drafts Scene.narrationDeliveryNotes/
  // narrationSpeed from the scene's own narration text — see
  // generateNarrationDirection in lib/voice.ts.
  NARRATION_DIRECTION
  // Drafts Scene.narration plus, only when the scene currently has none, new
  // DialogueLine rows for characters already attached to the scene — same
  // "AI proposes, user can overwrite/edit" shape as AUDIO_PLANNING, one level
  // up from DIALOGUE_DIRECTION (which only redirects lines that already
  // exist). See generateSceneScript in lib/voice.ts.
  SCRIPT_DRAFTING
  // Story chat AI — a conversational surface scoped to a Story/Episode,
  // reusing the Context Engine as system context. No dedicated schema for
  // chat history (kept client-side, stateless per request, same "simpler"
  // reasoning as not persisting it); "Add to Story"/"Add to Episode Summary"
  // applies a reply through the existing content/summary save routes.
  STORY_CHAT
  // Phase 9 — one-time document ingestion: extracts StoryBible +
  // SeriesBlueprint + Characters + Locations from an uploaded PDF/DOCX's
  // text as a single strict-JSON call. Result is a preview, not a write —
  // see lib/story-ingestion.ts.
  STORY_INGESTION
  // Phase 9 — SeriesBlueprint's own "Generate" button, drafting from
  // assembleContext() (which by then includes StoryBible/Characters/
  // Locations). Mirrors STORY_WRITING one level down.
  BLUEPRINT_PLANNING
  // Drafts Scene.motionPrompt for IMAGE_TO_VIDEO scenes from two multimodal
  // inputs in one call: the current scene's selected shot image (what's in
  // frame) and the immediately preceding scene's selected video clip (what
  // just happened, visually and in audio) via OpenRouter's video-input
  // content part — falls back to the previous scene's description text when
  // it has no generated clip yet. Needs a video-input-capable model (e.g.
  // Gemini 2.5 Pro/Flash); see generateSceneVideo in lib/scene-video.ts.
  MOTION_PROMPT_DRAFTING
  // Phase 11 — one whole-story/episode pass that watches the fully
  // assembled, still-silent picture (video-input content part, same
  // mechanism as MOTION_PROMPT_DRAFTING) and proposes narration/dialogue/
  // musicPrompt/sfxPrompt per scene, grounded in what the assembled picture
  // actually shows/says rather than each scene's written description in
  // isolation. Supersedes AUDIO_PLANNING's blind per-scene music/sfx
  // planning — see draftAudioCuePlan in lib/audio-cue-plan.ts. AUDIO_PLANNING
  // itself stays in this enum (Postgres can't drop an enum value without a
  // riskier create-new-type/swap/drop-old-type migration) but nothing calls
  // it anymore.
  AUDIO_CUE_PLANNING
  // Drafts Scene.videoDurationSeconds: a text-only reasoning call over the
  // scene's description/motion prompt/narration (plus the existing
  // voice-audio-length hint from getSceneVoiceDurationSeconds, when there's
  // already narration/dialogue) that recommends how many seconds the clip
  // should run and why. Same "AI proposes into the editable field, user
  // reviews and saves" shape as MOTION_PROMPT_DRAFTING one field over — see
  // recommendVideoDuration in lib/scene-video.ts.
  DURATION_RECOMMENDATION
}

model AiModelOption {
  id      String    @id @default(cuid())
  jobType AiJobType

  provider    String
  modelId     String
  displayName String
  isDefault   Boolean @default(false)
  isEnabled   Boolean @default(true)
  config      Json?

  projectDefaults ProjectModelDefault[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_model_options")
}

enum GenerationEntityType {
  SCENE
  SHOT
  DIALOGUE_LINE
}

// Cost-capture log for the metered generation job types (IMAGE_GENERATION,
// VIDEO_GENERATION, VOICE, MUSIC_GENERATION, SFX_GENERATION) — OpenRouter
// hands back the exact USD cost per call and nothing previously captured it.
// Append-only (createdAt only, no updatedAt — same convention as Asset/
// Version), and deliberately no relations to Project/Scene/Shot/DialogueLine:
// same "dangling id is just treated as unset" reasoning as AiModelOption.modelId
// above — a cost/audit row should survive its parent scene or shot being
// deleted, not cascade away with it. costUsd is nullable because only
// OpenRouter's response bodies expose it; ElevenLabs/Sarvam calls still log
// provider/duration/success for reliability signal, with costUsd left null.
model GenerationEvent {
  id       String    @id @default(cuid())
  jobType  AiJobType
  provider String
  modelId  String?

  projectId  String
  entityType GenerationEntityType?
  entityId   String?

  costUsd      Float?
  durationMs   Int
  success      Boolean
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([jobType])
  @@map("generation_events")
}

// Phase 13 — a project's preferred model for a given job type, overriding
// the global AiModelOption.isDefault for calls made within that project.
// Resolution order everywhere a model is picked: per-action override (e.g.
// Shot.videoModelId) > this row, if one exists for the project+jobType and
// aiModelOptionId isn't null > AiModelOption.isDefault (global fallback).
// aiModelOptionId is nullable with onDelete SetNull (not Cascade) so
// deleting the referenced AiModelOption row degrades this project back to
// the global default instead of erroring or silently deleting the project's
// preference row.
model ProjectModelDefault {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobType   AiJobType

  aiModelOptionId String?
  aiModelOption   AiModelOption? @relation(fields: [aiModelOptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, jobType])
  @@map("project_model_defaults")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth — email/password accounts with two roles. USER accounts self-service
// signup via a static admin code or a one-time invite link (see Invite
// below); ADMIN accounts are never created through the app itself, only by
// the boot-time bootstrap script reading ADMIN_EMAIL/ADMIN_PASSWORD — see
// packages/db/src/bootstrap-admin.ts. An admin can read/write every Project;
// a USER only their own (Project.ownerId) — enforced centrally in
// apps/web/src/proxy.ts rather than in each of the ~78 API routes.
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)

  ownedProjects Project[]
  sessions      Session[]

  // Invites this user (as an admin) has generated — not invites redeemed by
  // them, hence the separate named relation from Invite.usedBy below.
  invitesCreated  Invite[] @relation("InviteCreatedBy")
  invitesRedeemed Invite[] @relation("InviteUsedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Server-side session record backing the httpOnly session cookie.
// `tokenHash` is a sha256 hex digest of the raw token — the raw token itself
// only ever lives in the cookie, never persisted, so a DB read/leak alone
// can't be replayed as a live session. Fixed expiresAt at creation (30
// days), no sliding renewal — simplest thing that works for V1.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("sessions")
}

// A one-time signup link an admin generates from Settings → People. `code`
// is the random token embedded in the shareable /signup?invite=<code> URL;
// sending that link is a manual, out-of-band step (copy/paste — no email
// infra in this app). usedById is nullable+unique so an invite can be
// redeemed at most once, backstopping the same check the signup route makes
// against concurrent redemption.
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?

  createdAt DateTime @default(now())

  @@map("invites")
}
