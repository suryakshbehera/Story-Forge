# Postgres (matches docker-compose.yml defaults — change both together)
DATABASE_URL="postgresql://narrata:narrata@127.0.0.1:5555/narrata"

# OpenRouter — required for Master AI, Story Writing, Scene Planning, Image
# Prompts/Generation/Validation, Video Generation, and everything else text-
# or vision-based (all routed through OpenRouter's unified API). Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ElevenLabs — required for Voice (narration + dialogue TTS), Music
# Generation, and SFX Generation. Character.voiceName / Project.
# narratorVoiceName must hold ElevenLabs voice IDs, not OpenRouter/OpenAI
# voice names. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Sarvam AI — a second Voice provider, only needed if you pick "Sarvam
# Bulbul v3" instead of ElevenLabs for a given generation (Settings → AI
# Models / the model picker next to each Generate Audio button). Covers
# Indic languages ElevenLabs' TTS doesn't (e.g. Odia) — the Story/Series
# Language must be one Sarvam supports (see lib/languages.ts). Get a key at
# https://dashboard.sarvam.ai (Settings → API Key).
SARVAM_API_KEY=

# Local asset storage root (reference images, generated media). Change if you
# want assets stored outside the repo.
STORAGE_ROOT="../../storage"

# Auth — required in production. Read by packages/db/src/bootstrap-admin.ts,
# run automatically on every container boot (see the repo-root Dockerfile),
# before `pnpm start`. Idempotent upsert by email; ADMIN_PASSWORD is
# re-applied on every boot — the only way to rotate the admin's own
# password, since there's no self-service reset flow for that account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Static self-service signup code — anyone with this code can register as a
# regular user at /signup. Leave unset to disable code-based signup entirely
# (invite-link signup via Settings → People still works either way).
SIGNUP_CODE=

# Final video assembly (the "Video" job type) renders locally via ffmpeg
# rather than OpenRouter — no API key needed, but `ffmpeg` and `ffprobe` must
# both be installed and on PATH (confirm with `ffmpeg -version`). Not an env
# var; noted here since it's a local setup requirement like Postgres above.
